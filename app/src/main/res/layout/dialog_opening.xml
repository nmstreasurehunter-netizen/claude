<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView android:id="@+id/title" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textColor="@color/txt"
        android:textSize="19sp" android:textStyle="bold" />

    <TextView android:id="@+id/info" style="@style/T.Label"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <TextView style="@style/T.Label" android:layout_marginTop="14dp" android:text="Type" />

    <Spinner android:id="@+id/spType" android:layout_width="match_parent"
        android:layout_height="52dp" android:layout_marginTop="4dp"
        android:background="@drawable/bg_field" />

    <TextView style="@style/T.Label" android:layout_marginTop="12dp" android:text="Largeur (cm)" />

    <EditText android:id="@+id/edWidth" android:layout_width="match_parent"
        android:layout_height="52dp" android:layout_marginTop="4dp"
        android:background="@drawable/bg_field" android:inputType="numberDecimal"
        android:paddingLeft="12dp" android:textColor="@color/txt" android:textSize="17sp" />

    <TextView style="@style/T.Label" android:layout_marginTop="12dp" android:text="Position sur le mur" />

    <SeekBar android:id="@+id/barPos" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:max="100" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/btnFlipHinge" style="@style/Cta"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp"
            android:layout_marginEnd="6dp" android:background="@drawable/bg_cta_ghost">
            <TextView style="@style/CtaText" android:textColor="@color/accent"
                android:textSize="14sp" android:text="Inverser le gond" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnFlipSwing" style="@style/Cta"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="46dp"
            android:layout_marginStart="6dp" android:background="@drawable/bg_cta_ghost">
            <TextView style="@style/CtaText" android:textColor="@color/accent"
                android:textSize="14sp" android:text="Inverser le sens" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/btnDelete" style="@style/Cta"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:layout_marginEnd="6dp" android:background="@drawable/bg_cta_ghost">
            <TextView style="@style/CtaText" android:textColor="@color/danger"
                android:textSize="15sp" android:text="@string/delete" />
        </LinearLayout>

        <LinearLayout android:id="@+id/btnOk" style="@style/Cta"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:layout_marginStart="6dp">
            <TextView style="@style/CtaText" android:textSize="15sp" android:text="@string/apply" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
